msgstr "Link öffnen"

#: packages/wordpress/src/Integration/MapPayload.php:202
msgid "Close"
msgstr "Schließen"

#: packages/wordpress/src/Integration/MapPayload.php:203
msgid "Search locations"
msgstr "Standorte suchen"

#: packages/wordpress/src/Integration/MapPayload.php:204
msgid "Filter by category"
msgstr "Nach Kategorie filtern"

#: packages/wordpress/src/Integration/MapPayload.php:205
msgid "No locations found."
msgstr "Keine Standorte gefunden."

#: packages/wordpress/src/Integration/Privacy.php:36
msgid "This text is a suggestion. Check it against your configuration and have it reviewed."
msgstr "Dieser Text ist ein Vorschlag. Prüfen Sie ihn anhand Ihrer Konfiguration und lassen Sie ihn juristisch prüfen."

#: packages/wordpress/src/Integration/Privacy.php:37
msgid "We display interactive maps. When a map is loaded, your browser requests map tiles from the map provider. The provider receives your IP address and technical request data. SW Maps itself sets no cookies and sends no data to third parties other than the configured map provider."
msgstr "Wir zeigen interaktive Karten an. Beim Laden einer Karte fordert Ihr Browser Kartenkacheln beim Kartenanbieter an. Der Anbieter erhält Ihre IP-Adresse und technische Anfragedaten. SW Maps selbst setzt keine Cookies und sendet keine Daten an Dritte außer dem konfigurierten Kartenanbieter."

#. translators: %s: comma separated list of tile server host names
#: packages/wordpress/src/Integration/Privacy.php:40
#, php-format
msgid "Currently configured tile servers: %s."
msgstr "Aktuell konfigurierte Kachelserver: %s."

#: packages/wordpress/src/Integration/Privacy.php:42
msgid "Maps are loaded only after you consent or after you click \"Load map\", depending on the site configuration."
msgstr "Karten werden je nach Konfiguration der Website erst nach Ihrer Einwilligung oder nach einem Klick auf „Karte laden“ geladen."

#: packages/wordpress/src/Integration/Renderer.php:106
msgid "Draft preview: this map is not published."
msgstr "Entwurfsvorschau: Diese Karte ist nicht veröffentlicht."

#: packages/wordpress/src/Integration/Renderer.php:126
msgid "Location"
msgstr "Standort"

#: packages/wordpress/src/Integration/Renderer.php:135
msgid "Show on map"
msgstr "Auf der Karte zeigen"

#: packages/wordpress/src/Integration/Renderer.php:138
msgid "Locations"
msgstr "Standorte"

#. translators: 1: required PHP version, 2: current PHP version
#: sw-maps.php:36
#, php-format
msgid "SW Maps requires PHP %1$s or newer. You are running PHP %2$s."
msgstr "SW Maps benötigt PHP %1$s oder neuer. Sie verwenden PHP %2$s."

#: sw-maps.php:59
msgid "SW Maps: the vendor directory is missing. Install the release package or run \"composer install\"."
msgstr "SW Maps: Das Verzeichnis „vendor“ fehlt. Release-Paket installieren oder „composer install“ ausführen."
