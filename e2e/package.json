{
  "name": "sw-maps-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SW Maps Playwright end-to-end tests (WordPress mode via bin/test-e2e.sh, mock mode without WordPress)",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:mock": "playwright test -c playwright.mock.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.55.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.0",
    "globals": "16.0.0",
    "prettier": "3.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "playwright-core": "1.55.1"
  }
}
