{
  "name": "@sw-maps/renderer-openlayers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenLayers renderer (viewer and editor) with the frontend bundle.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node ../../scripts/check-coverage.mjs coverage/coverage-summary.json"
  },
  "dependencies": {
    "ol": "^10.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.5"
  }
}
